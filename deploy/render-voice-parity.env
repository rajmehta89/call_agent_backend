# Non-secret voice settings matched to the recorded local configuration.
# Retain production credentials, database, public URL, and frontend origins.
LLM_PROVIDER=openrouter
RETELL_CUSTOM_LLM_ENABLED=true
RETELL_OPENROUTER_MODEL=openai/gpt-4.1-mini
RETELL_OPENROUTER_PROVIDER_ORDER=openai,azure,groq,deepinfra,coreweave
RETELL_OPENROUTER_REASONING_EFFORT=low
RETELL_MAX_RESPONSE_TOKENS=180
VOICE_FAST_MODEL=meta-llama/llama-3.1-8b-instruct
VOICE_FALLBACK_MODEL=google/gemini-3.1-flash-lite
VOICE_MODEL_STALL_SECONDS=6
VOICE_TEMPERATURE=0.3
VOICE_DEFAULT_REGION=AU
CUSTOM_STT=flux
CUSTOM_ENDPOINTING_MS=500
CUSTOM_FIRST_CHUNK_WORDS=4
CUSTOM_FILLER_AFTER_SECONDS=0.8
DEEPGRAM_TTS_VOICE=aura-2-thalia-en
DEEPGRAM_TTS_VOICE_UR=flux-ambreen-ur
DEEPGRAM_TTS_GAIN_DB=7
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_VOICE_AR=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_VOICE_UR=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL_ID=eleven_v4_turbo

# Local semantic decisions measured ~38-41 ms per fresh query after warm-up;
# the network alternative measured ~1077-1416 ms in the same server runtime.
# Enable this block after checking the Render instance's memory headroom.
# Local computer private memory exceeds 1 GB with the complete app warmed.
# These thread/batch limits reduce embedding memory without changing vectors.
# The local ElevenLabs account currently reports quota_exceeded (0 credits).
# Retain the active production speech provider; do not copy local credentials.
LOCAL_EMBEDDINGS=true
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
LOCAL_EMBEDDING_THREADS=1
LOCAL_EMBEDDING_BATCH_SIZE=8
