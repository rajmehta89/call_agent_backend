MONGO_URI=
MONGO_DB=inbound_call_crm

FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_ORIGIN_2=http://127.0.0.1:3000
AUTH_SECRET=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_CALLER_ID=
TWILIO_PUBLIC_BASE_URL=
TWILIO_CONVERSATION_LANG=en-US
TWILIO_HUMAN_AGENT_NUMBER=

LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.2
CONVERSATION_TEMPERATURE=0.35
RAG_TEMPERATURE=0.2
TOOL_TEMPERATURE=0.0
CLASSIFICATION_TEMPERATURE=0.0
LLM_TOP_P=1.0
# Log verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Retell agent that answers Twilio calls when Retell is the selected provider
RETELL_API_KEY=
RETELL_AGENT_ID=
# Required for Retell custom LLM sockets. Use the same value in the socket URL's token query parameter.
RETELL_CUSTOM_LLM_SECRET=

# Custom voice stack tuning (all optional)
# CUSTOM_VOICE_GREETING=Hi, thanks for calling. How can I help?
# CUSTOM_FILLER_AFTER_SECONDS=0     # off by default; e.g. 2.5 says "one moment" only for slow answers
# CUSTOM_DEEPGRAM_TTS_FIRST_AUDIO_TIMEOUT_MS=1500  # retry Deepgram REST if its WebSocket stalls before audio
# CUSTOM_MAX_SPOKEN_WORDS=35        # cap spoken answers at whole sentences
# English calls use Deepgram Flux turn detection by default. Select Arabic/Urdu per call to use Nova;
# set CUSTOM_AUTO_LANGUAGE=true to keep Nova's multilingual language switching during a call.
CUSTOM_AUTO_LANGUAGE=false
# Optional native Pipecat STT/TTS workers, reusing the existing CRM conversation controller.
# Install requirements-pipecat.txt before selecting pipecat. Missing dependencies fall back to legacy.
CUSTOM_VOICE_RUNTIME=legacy
# CUSTOM_ENDPOINTING_MS=500         # Nova pause (ms) that ends a caller sentence; lower = faster but may cut people off
# CUSTOM_UTTERANCE_END_MS=1000      # backup end-of-turn when speech trails off

# Dashboard origins allowed to call this API (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Dedicated email verification / invitation sender for this RelayDesk deployment.
# Do not reuse another client's mail credentials here.
RELAYDESK_SMTP_HOST=
RELAYDESK_SMTP_PORT=587
RELAYDESK_SMTP_FROM=
RELAYDESK_SMTP_USERNAME=
RELAYDESK_SMTP_PASSWORD=
RELAYDESK_SMTP_USE_TLS=true
# Local development default. Production must override this with the deployed frontend URL.
RELAYDESK_PUBLIC_APP_URL=http://127.0.0.1:3000
# Retained for compatibility; direct public signup is disabled and new users require invitations.
ALLOW_PUBLIC_SIGNUP=false
# Reject Twilio webhooks without a valid X-Twilio-Signature (set false only for local debugging)
TWILIO_VALIDATE_SIGNATURES=true

# Namecheap mailbox used for owner-approved Dubai emails and inbox preview
PRIVATE_EMAIL_ADDRESS=raj@buildwithraj.com
PRIVATE_EMAIL_PASSWORD=

# Free static ngrok domain (dashboard.ngrok.com > Domains) so the public URL never changes
# NGROK_DOMAIN=your-name.ngrok-free.app
